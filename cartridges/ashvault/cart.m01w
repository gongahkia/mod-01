format = 2
recipe = []
test = []

[cartridge]
language = "MODL/1"
id = "ashvault"
title = "ASHVAULT"
author = "@gongahkia"
version = "1.0.0-alpha.1"
entry = "src/main.modl"
update_rate = 60
hardware_revision = 2
compile_on_load = false
label = "presentation/label.svg"
thumbnail = "presentation/thumbnail.svg"
display = "assets/display.m01p"

[[module]]
path = "src/main.modl"
source = """
// ASHVAULT
// Made by @gongahkia

const GRID_W: Int = 20
const GRID_H: Int = 12
const CELL: Int = 10
const RELIC_COUNT: Int = 5

record Explorer:
  x: Int
  y: Int
  hp: Int = 4
  relics: Int = 0

enum RunState:
  Title
  Explore
  Escaped
  Fallen

state run_state: RunState = RunState.Title
state hero: Explorer = Explorer(1, 1)
state cells: List[Int, 240] = []
state seen: List[Int, 240] = []
state enemies_x: List[Int, 4] = []
state enemies_y: List[Int, 4] = []
state turn: Int = 0
state depth: Int = 0
state pulse: Int = 0

fn index_of(cell_x: Int, cell_y: Int) -> Int:
  return cell_y * GRID_W + cell_x

fn in_bounds(cell_x: Int, cell_y: Int) -> Bool:
  return cell_x >= 0 and cell_y >= 0 and cell_x < GRID_W and cell_y < GRID_H

fn is_wall(cell_x: Int, cell_y: Int) -> Bool:
  if not in_bounds(cell_x, cell_y):
    return true
  return cells[index_of(cell_x, cell_y)] == 1

fn reveal() -> Unit:
  for reveal_y in hero.y - 3..hero.y + 4:
    for reveal_x in hero.x - 4..hero.x + 5:
      if in_bounds(reveal_x, reveal_y):
        seen[index_of(reveal_x, reveal_y)] = 1

fn generate_vault() -> Unit:
  for cell_index in 0..240:
    cells[cell_index] = 0
    seen[cell_index] = 0
  for edge_x in 0..GRID_W:
    cells[index_of(edge_x, 0)] = 1
    cells[index_of(edge_x, GRID_H - 1)] = 1
  for edge_y in 0..GRID_H:
    cells[index_of(0, edge_y)] = 1
    cells[index_of(GRID_W - 1, edge_y)] = 1
  for stone in 0..34:
    let stone_x = rng_int(2, GRID_W - 2)
    let stone_y = rng_int(2, GRID_H - 2)
    cells[index_of(stone_x, stone_y)] = 1
  // keep a sparse spine from the entrance to every objective for every seed
  for path_x in 1..GRID_W - 1:
    cells[index_of(path_x, 1)] = 0
  for path_y in 1..GRID_H - 1:
    cells[index_of(18, path_y)] = 0
  for path_y in 1..4:
    cells[index_of(3, path_y)] = 0
  for path_y in 1..9:
    cells[index_of(6, path_y)] = 0
  for path_y in 1..3:
    cells[index_of(10, path_y)] = 0
  for path_y in 1..8:
    cells[index_of(14, path_y)] = 0
  for path_y in 1..10:
    cells[index_of(17, path_y)] = 0
  cells[index_of(1, 1)] = 0
  cells[index_of(2, 1)] = 0
  cells[index_of(1, 2)] = 0
  cells[index_of(3, 3)] = 3
  cells[index_of(6, 8)] = 3
  cells[index_of(10, 2)] = 3
  cells[index_of(14, 7)] = 3
  cells[index_of(17, 9)] = 3
  cells[index_of(18, 10)] = 2
  hero = Explorer(1, 1)
  enemies_x[0] = 5
  enemies_y[0] = 5
  enemies_x[1] = 9
  enemies_y[1] = 8
  enemies_x[2] = 13
  enemies_y[2] = 3
  enemies_x[3] = 17
  enemies_y[3] = 6
  turn = 0
  reveal()

fn move_wraith(enemy: Int) -> Unit:
  var next_x = enemies_x[enemy]
  var next_y = enemies_y[enemy]
  if turn % 2 == enemy % 2:
    if next_x < hero.x:
      next_x += 1
    elif next_x > hero.x:
      next_x -= 1
  else:
    if next_y < hero.y:
      next_y += 1
    elif next_y > hero.y:
      next_y -= 1
  if not is_wall(next_x, next_y):
    enemies_x[enemy] = next_x
    enemies_y[enemy] = next_y
  if enemies_x[enemy] == hero.x and enemies_y[enemy] == hero.y:
    hero.hp -= 1
    sfx(#bump)
    enemies_x[enemy] = 2 + enemy * 4
    enemies_y[enemy] = 9 - enemy

fn take_turn(delta_x: Int, delta_y: Int) -> Unit:
  let next_x = hero.x + delta_x
  let next_y = hero.y + delta_y
  if is_wall(next_x, next_y):
    sfx(#bump)
    return
  hero.x = next_x
  hero.y = next_y
  sfx(#step)
  let landing = index_of(hero.x, hero.y)
  if cells[landing] == 3:
    cells[landing] = 0
    hero.relics += 1
    sfx(#found)
  elif cells[landing] == 2:
    if hero.relics >= RELIC_COUNT:
      run_state = RunState.Escaped
      depth += 1
      save_set_int("deepest_vault", depth)
      music_stop()
      sfx(#found)
      return
    else:
      sfx(#bump)
  turn += 1
  for enemy in 0..4:
    move_wraith(enemy)
  reveal()
  if hero.hp <= 0:
    run_state = RunState.Fallen
    music_stop()

on start:
  depth = save_get_int("deepest_vault", 0)
  generate_vault()

on update:
  pulse += 1
  if run_state == RunState.Title:
    if btnp(pad1, a) or btnp(pad1, start_button):
      generate_vault()
      run_state = RunState.Explore
      music(#lament)
  elif run_state == RunState.Explore:
    if btnp(pad1, up):
      take_turn(0, -1)
    elif btnp(pad1, down):
      take_turn(0, 1)
    elif btnp(pad1, left):
      take_turn(-1, 0)
    elif btnp(pad1, right):
      take_turn(1, 0)
  elif btnp(pad1, a) or btnp(pad1, start_button):
    run_state = RunState.Title

on draw:
  if run_state == RunState.Title:
    clear(28)
    for band in 0..12:
      rect_fill(band * 20, 0, 10, 144, dither(band, pulse / 10, 28, 29, 8))
    rect_fill(27, 18, 186, 110, 1)
    rect(27, 18, 186, 110, 30)
    sprite_xform(#gate, 104, 26, 4, 0, false, false)
    print("ASHVAULT", 94, 67, 30)
    print("FIND FIVE RELICS", 74, 84, 15)
    print("REACH THE CYAN GATE", 62, 94, 23)
    print("ARROWS MOVE  Z START", 59, 110, 7)
  elif run_state == RunState.Explore:
    clear(0)
    rect_fill(18, 12, 204, 124, 1)
    for cell_index in 0..240:
      let cell_x = cell_index % GRID_W
      let cell_y = cell_index / GRID_W
      let screen_x = 20 + cell_x * CELL
      let screen_y = 14 + cell_y * CELL
      if seen[cell_index] == 1:
        rect_fill(screen_x, screen_y, 9, 9, dither(cell_x, cell_y, 2, 3, 6))
        if cells[cell_index] == 1:
          rect_fill(screen_x, screen_y, 9, 9, 29)
          rect(screen_x + 1, screen_y + 1, 7, 7, 28)
        elif cells[cell_index] == 2:
          sprite(#gate, screen_x + 1, screen_y + 1)
        elif cells[cell_index] == 3:
          sprite(#relic, screen_x + 1, screen_y + 1)
    for enemy in 0..4:
      if seen[index_of(enemies_x[enemy], enemies_y[enemy])] == 1:
        sprite(#wraith, 21 + enemies_x[enemy] * CELL, 15 + enemies_y[enemy] * CELL)
    sprite(#seeker, 21 + hero.x * CELL, 15 + hero.y * CELL)
    rect_fill(0, 0, 240, 11, 1)
    print("ASHVAULT", 4, 2, 30)
    for heart in 0..hero.hp:
      rect_fill(67 + heart * 7, 3, 5, 5, 11)
    for relic in 0..hero.relics:
      circle_fill(116 + relic * 8, 5, 3, 15)
    print("EXIT", 207, 2, 23)
  elif run_state == RunState.Escaped:
    clear(20)
    circle_fill(120, 54, 36 + (pulse / 4) % 5, 22)
    sprite_xform(#seeker, 108, 42, 4, 0, false, false)
    print("VAULT CLEARED", 82, 93, 23)
    print("DEPTH SAVED", 88, 106, 15)
    print("Z TO DESCEND AGAIN", 67, 122, 7)
  else:
    clear(8)
    sprite_xform(#wraith, 108, 32, 4, 0, false, false)
    print("THE ASH CLOSES IN", 65, 82, 11)
    print("Z TO RETURN", 88, 105, 7)

on raster(line: Int):
  if run_state == RunState.Title and line < 64:
    if (line / 4 + pulse / 8) % 2 == 0:
      pal(29, 29)
    else:
      pal(29, 31)
"""

