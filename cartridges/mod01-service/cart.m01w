format = 2
file = []
recipe = []
test = []

[cartridge]
language = "MODL/1"
id = "mod01-service"
title = "MOD-01 SERVICE CARTRIDGE"
author = "@gongahkia"
version = "1.0.0"
entry = "src/main.modl"
update_rate = 60
hardware_revision = 2
compile_on_load = false

[[module]]
path = "src/main.modl"
source = """
// MOD-01 Hardware Revision 1 service cartridge
// Made by @gongahkia

const PALETTE: Int = 2097152
const INPUT: Int = 327936
const SYSTEM: Int = 328192
const VISUAL_INFO: Int = 328448
const RASTER_LIVE: Int = 328704
const SAVE_CONTROL: Int = 328960
const CART_INFO: Int = 329216
const AUDIO: Int = 331776
const VOICES: Int = 332032
const RASTER: Int = 348160
const SAVE: Int = 360448
const SAVE_COMMITTED: Int = 368640
const CART_ROM: Int = 1048576
const AUDIO_DESCRIPTORS: Int = 3932160

state page: Int = 0
state frame_count: Int = 0
state update_count: Int = 0
state task_steps: Int = 0
state service_runs: Int = 0

fn word32(address: Int) -> Int:
  return mem_read16(address) + mem_read16(address + 2) * 65536

fn bit(value: Int, mask: Int) -> Bool:
  return (value / mask) % 2 == 1

task scheduler_probe():
  for step in 0..3:
    task_steps += 1
    wait 1f

on start:
  assert mem_read(0) == 0, "work RAM reset"
  assert mem_read(65536) == 0, "front framebuffer reset"
  assert mem_read(102400) == 0, "back framebuffer reset"
  assert mem_read(139264) == 0, "scanout reset"
  assert mem_read(PALETTE) == 23, "fixed palette"
  assert mem_read16(VISUAL_INFO) == 0, "no visual assets"
  assert mem_read16(RASTER + 40) == 0, "raster table reset"
  assert mem_read16(SAVE_CONTROL + 4) == 8192, "save capacity"
  assert mem_read16(CART_INFO) == 2, "hardware revision"
  assert mem_read16(CART_INFO + 2) == 2, "format revision"
  assert mem_read(CART_INFO + 16) == 3, "canonical ROM flags"
  assert mem_read(CART_ROM) == 77 and mem_read(CART_ROM + 1) == 79, "M01 ROM magic"
  assert mem_read(AUDIO + 17) == 8 and mem_read(AUDIO + 18) == 8, "audio capacities"
  assert mem_read16(AUDIO + 20) == 48000, "sample rate"
  assert mem_read16(AUDIO + 24) == 1, "audio asset count"
  assert mem_read16(AUDIO_DESCRIPTORS) == 1, "sound descriptor"
  assert audio_id("tone") == 0, "audio ID"
  assert mem_read(SYSTEM + 28) == 60, "update cadence"
  assert mem_read16(SYSTEM + 40) == 50000, "work ceiling"
  assert mem_read(SYSTEM + 48) == 2, "boot status"
  assert mem_read(1048575) == 0, "reserved reads zero"
  mem_write16(1, 4660)
  assert mem_read(1) == 52 and mem_read(2) == 18, "little endian unaligned word"
  mem_copy(2, 1, 2)
  assert mem_read16(2) == 4660, "overlap-safe copy"
  mem_fill(1, 0, 3)
  assert mem_read16(1) == 0, "memory fill"
  service_runs = save_get_int("service_runs", 0) + 1
  save_set_int("service_runs", service_runs)
  assert mem_read16(SAVE_CONTROL + 8) == 1, "save commit"
  assert mem_read(SAVE_CONTROL + 1) == 2, "save awaits host"
  assert mem_read(SAVE) == mem_read(SAVE_COMMITTED), "save latch alias"
  sfx(#tone)
  assert mem_read(AUDIO + 16) == 1, "voice high-level alias"
  assert mem_read(VOICES) == 1, "voice register active"
  start scheduler_probe()

on update:
  assert word32(SYSTEM) == frame_count, "frame counter"
  assert word32(SYSTEM + 8) == update_count, "update counter"
  assert mem_read(SYSTEM + 29) == 2, "update phase"
  let before_rng = word32(SYSTEM + 24)
  let sample = rng_int(0, 16)
  assert sample >= 0 and sample < 16, "RNG range"
  assert word32(SYSTEM + 24) != before_rng, "RNG register alias"
  if btnp(pad1, right) or btnp(pad1, a):
    page = (page + 1) % 8
  elif btnp(pad1, left) or btnp(pad1, b):
    page = (page + 7) % 8
  update_count += 1

on draw:
  assert word32(SYSTEM) == frame_count, "draw frame counter"
  assert word32(SYSTEM + 8) == update_count, "draw update counter"
  assert mem_read(SYSTEM + 29) == 3, "draw phase"
  let held = mem_read16(INPUT)
  assert bit(held, 16) == btn(pad1, a), "controller held alias"
  assert bit(mem_read16(INPUT + 4), 16) == btnp(pad1, a), "controller edge alias"
  clear(1)
  rect_fill(4, 4, 232, 15, 25)
  print("MOD-01 SERVICE / HARDWARE R1", 10, 9, 15)
  print("ALL LIVE CHECKS PASS", 54, 27, 19)
  if page == 0:
    print("RESET + BUS", 82, 48, 23)
    print("RAM / FRAMEBUFFERS / PALETTE", 34, 62, 7)
  elif page == 1:
    print("DISPLAY + RASTER", 70, 48, 23)
    print("144 ROWS / INDEXED SCANOUT", 40, 62, 7)
  elif page == 2:
    print("INPUT", 100, 48, 23)
    print("4 PORTS / HELD + EDGES", 49, 62, 7)
  elif page == 3:
    print("AUDIO", 100, 48, 23)
    print("8 VOICES / 48000 HZ", 58, 62, 7)
  elif page == 4:
    print("SAVE", 103, 48, 23)
    print("8192 BYTES / EXPLICIT COMMIT", 34, 62, 7)
  elif page == 5:
    print("CARTRIDGE ROM", 79, 48, 23)
    print("CANONICAL BYTES AT 060000", 43, 62, 7)
  elif page == 6:
    print("SCHEDULER + RNG", 70, 48, 23)
    print("DETERMINISTIC COUNTERS + TASKS", 25, 62, 7)
  else:
    print("FAULT CONTRACT", 79, 48, 23)
    print("BOUNDS + PERMISSIONS IN HOST SUITE", 16, 62, 7)
  print("A/RIGHT NEXT  B/LEFT PREV", 43, 84, 11)
  print("FRAME", 62, 105, 6)
  print("UPDATES", 62, 115, 6)
  print("TASK STEPS", 62, 125, 6)
  pixel(0, 0, 7)
  assert mem_read(102400) == 7, "draw framebuffer alias"
  assert mem_read(RASTER_LIVE + 16) == 0, "live remap reset"

on raster(line: Int):
  assert mem_read(SYSTEM + 29) == 4, "raster phase"
  assert mem_read16(SYSTEM + 30) == line, "raster line"
  if line == 0:
    pal(7, 15)
    assert mem_read(RASTER_LIVE + 23) == 15, "raster remap alias"
    assert mem_read(RASTER) == 1, "raster record enabled"
  if line == 143:
    frame_count += 1
"""

[[asset]]
name = "tone"
kind = "sound"
path = "assets/tone.m01s"
payload = """
{"revision":1,"kind":"sound","waveform":"pulse","note":69,"durationFrames":4,"volume":0.5,"pan":0,"duty":0.5,"envelope":{"attackFrames":0,"decayFrames":0,"sustainLevel":1,"releaseFrames":1},"pitch":{"slideSemitonesPerFrame":0,"vibratoDepthSemitones":0,"vibratoPeriodFrames":0}}
"""
