[[module]]
path = "src/main.modl"
source = """
// An asset donor is admitted/compiled with the game but must not be booted.
// This deliberate assertion makes an accidental program load visible in QA.
on start:
  assert false, "night is data-only: use reload_assets, not load_cart"
"""

[[asset]]
name = "hero"
kind = "sprite"
path = "assets/hero.m01g"
payload = '{"revision":2,"kind":"sprite","width":8,"height":8,"frames":[[0,0,19,19,19,19,0,0,0,19,7,19,19,7,19,0,0,19,19,19,19,19,19,0,0,0,19,19,19,19,0,0,0,19,19,7,7,19,19,0,19,0,19,19,19,19,0,19,0,0,19,0,0,19,0,0,0,19,19,0,0,19,19,0]]}'

