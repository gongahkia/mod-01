path = "assets/tone.m01s"
payload = '{"revision":1,"kind":"sound","waveform":"pulse","note":72,"durationFrames":12,"volume":0.35,"pan":0,"duty":0.25,"envelope":{"attackFrames":0,"decayFrames":2,"sustainLevel":0.7,"releaseFrames":4},"pitch":{"slideSemitonesPerFrame":0,"vibratoDepthSemitones":0,"vibratoPeriodFrames":0}}'
