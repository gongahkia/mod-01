format = 2
file = []
recipe = []

[cartridge]
language = "MODL/1"
id = "api-tour"
title = "MODL API TOUR"
author = "@gongahkia"
version = "1.0.0"
entry = "src/main.modl"
update_rate = 60
hardware_revision = 2
compile_on_load = false

[[module]]
path = "src/main.modl"
source = """
import src.motion as motion

state cursor_x: Int = 16
state ticks: Int = 0

task clock():
  while true:
    ticks += 1
    wait 30f

on start:
  cursor_x = save_get_int("x", 16)
  mem_write16(0, 923)
  assert mem_read16(0) == 923, "little endian bus"
  music(#loop)
  start clock()

on update:
  if btn(pad1, left) or btn(pad2, left) or btn(pad3, left) or btn(pad4, left):
    cursor_x = motion.wrap(cursor_x - 1, 240)
  if btnp(pad1, a):
    sfx(#beep)
    save_set_int("x", cursor_x)
    save_commit()

on draw:
  clear(1)
  map(#room, 8, 8)
  sprite(#dot, cursor_x, 72)
  font_print(#typeface, "?", 116, 40, 23)
  print("4P LEFT / P1 A SAVE", 55, 104, 7)
  print("WORK", 84, 116, 6)
  print("BUS R1", 132, 116, 6)

on raster(line: Int):
  if line == 72:
    pal(7, 23)
    raster_scroll(ticks, 0)
"""

[[module]]
path = "src/motion.modl"
source = """
pub fn wrap(value: Int, limit: Int) -> Int:
  if value < 0:
    return limit - 1
  return value % limit
"""

