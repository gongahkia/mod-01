{
  "name": "mod01",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "MOD-01 Color Development Unit",
  "author": "@gongahkia",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "check": "./scripts/check.sh",
    "dev": "pnpm native",
    "native": "pnpm --dir packages/runtime build && cargo run -p mod01-native",
    "native:package": "pnpm --dir packages/runtime build && cargo build --release -p mod01-native -p mod01-cli && node scripts/package-native.mjs",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "pnpm --recursive --if-present run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.1",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
