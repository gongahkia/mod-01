[cartridge]
language = "MODL/1"
id = "arcade-start"
title = "ARCADE START"
author = "@gongahkia"
version = "0.1.0"
entry = "src/main.modl"
update_rate = 60
hardware_revision = 2
compile_on_load = false

[[module]]
path = "src/main.modl"
source = """
state player_x: Int = 116
state score: Int = 0
on update:
  if btn(pad1, left):
    player_x -= 2
  if btn(pad1, right):
    player_x += 2
on draw:
  clear(1)
  rect_fill(player_x, 120, 8, 8, 23)
  print("SCORE", 8, 8, 7)
"""
