[cartridge]
language = "MODL/1"
id = "four-player-start"
title = "FOUR PLAYER START"
author = "@gongahkia"
version = "0.1.0"
entry = "src/main.modl"
update_rate = 60
hardware_revision = 2
compile_on_load = false

[[module]]
path = "src/main.modl"
source = """
state p1: Int = 20
state p2: Int = 75
state p3: Int = 130
state p4: Int = 185
on update:
  if btn(pad1, right):
    p1 += 1
  if btn(pad2, right):
    p2 += 1
  if btn(pad3, right):
    p3 += 1
  if btn(pad4, right):
    p4 += 1
on draw:
  clear(1)
  circle_fill(p1, 72, 6, 7)
  circle_fill(p2, 72, 6, 11)
  circle_fill(p3, 72, 6, 19)
  circle_fill(p4, 72, 6, 23)
"""
