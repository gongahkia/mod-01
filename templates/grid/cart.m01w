format = 2
asset = []
file = []
recipe = []
test = []

[cartridge]
language = "MODL/1"
id = "grid-start"
title = "GRID START"
author = "@gongahkia"
version = "0.1.0"
entry = "src/main.modl"
update_rate = 30
hardware_revision = 2
compile_on_load = false

[[module]]
path = "src/main.modl"
source = """
state gx: Int = 7
state gy: Int = 4
on update:
  if btnp(pad1, left):
    gx -= 1
  if btnp(pad1, right):
    gx += 1
  if btnp(pad1, up):
    gy -= 1
  if btnp(pad1, down):
    gy += 1
on draw:
  clear(1)
  for y in 0..9:
    for column in 0..15:
      rect(column * 16, y * 16, 16, 16, 6)
  rect_fill(gx * 16 + 4, gy * 16 + 4, 8, 8, 23)
"""
