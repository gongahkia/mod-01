format = 2
asset = []
file = []
recipe = []
test = []

[cartridge]
language = "MODL/1"
id = "platform-start"
title = "PLATFORM START"
author = "@gongahkia"
version = "0.1.0"
entry = "src/main.modl"
update_rate = 60
hardware_revision = 2
compile_on_load = false

[[module]]
path = "src/main.modl"
source = """
state player_y: Int = 104
state vy: Int = 0
on update:
  if player_y == 104 and btnp(pad1, a):
    vy = -7
  vy += 1
  player_y += vy
  if player_y > 104:
    player_y = 104
    vy = 0
on draw:
  clear(1)
  rect_fill(0, 120, 240, 24, 11)
  rect_fill(112, player_y, 12, 16, 23)
"""
