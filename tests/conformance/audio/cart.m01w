format = 2
file = []
recipe = []
test = []

[cartridge]
language = "MODL/1"
id = "audio-conformance"
title = "AUDIO CONFORMANCE"
author = "@gongahkia"
version = "0.1.0"
entry = "main.modl"
update_rate = 60
hardware_revision = 2
compile_on_load = false

[[module]]
path = "main.modl"
source = """
// all writes target the production synth; captured PCM must follow these controls.
const AUDIO: Int = 331776
const TRACKER: Int = 331808
const VOICES: Int = 332032
state frames: Int = 0

on start:
  assert audio_id("absent") == -1, "unknown audio ID"
  assert audio_id("theme") == 0, "sorted music ID"
  assert audio_id("tone") == 1, "sorted sound ID"
  assert mem_read16(AUDIO) == 0, "audio clock reset"
  assert mem_read16(AUDIO + 8) == 1, "allocation sequence reset"
  assert mem_read(AUDIO + 16) == 0, "voice reset"
  assert mem_read(AUDIO + 17) == 8, "eight voices"
  assert mem_read(AUDIO + 18) == 8, "eight tracker channels"
  assert mem_read16(AUDIO + 20) == 48000, "sample rate"
  assert mem_read16(AUDIO + 24) == 2, "audio asset count"
  assert mem_read16(3932160) == 2, "music descriptor"
  assert mem_read16(3932192) == 1, "sound descriptor"
  assert mem_read16(3932200) == 69, "patch default note"
  music(#theme)
  assert mem_read16(TRACKER) == 1, "music start alias"
  mem_write16(TRACKER + 8, 1)
  assert mem_read16(TRACKER + 8) == 1, "raw tracker position"
  mem_write16(TRACKER, 0)
  assert mem_read(AUDIO + 19) == 0, "raw tracker stop"
  mem_write16(TRACKER, 1)
  assert mem_read(AUDIO + 19) == 1, "raw tracker start"
  music_stop()
  assert mem_read16(TRACKER) == 0, "music stop alias"
  for slot in 0..8:
    sfx(#tone)
    assert mem_read(VOICES + slot * 64) == 1, "boot voice command"
    mem_fill(VOICES + slot * 64 + 16, 0, 8)

on draw:
  assert mem_read16(AUDIO) == frames % 65536, "sample clock low word"
  for slot in 0..8:
    sfx(#tone)
    let address = VOICES + slot * 64
    assert mem_read(address) == 1, "voice active alias"
    assert mem_read16(address + 4) == audio_id("tone") + 1, "voice patch alias"
    assert mem_read16(address + 14) == 16465, "exact binary64 note"
    assert mem_read16(address + 24) == 0, "new voice age"
    if frames % 2 == 0:
      mem_fill(address + 16, 0, 8)
  assert mem_read(AUDIO + 16) == 8, "all voices active"
  mem_copy(0, AUDIO, 32)
  mem_copy(32, VOICES, 512)
  clear(0)
  print("AUDIO BUS PASS", 4, 24, 11)

on raster(line: Int):
  assert mem_read16(AUDIO) == frames % 65536, "raster does not advance samples"
  if line == 143:
    frames += 1
"""

[[asset]]
name = "theme"
kind = "music"
path = "theme.m01t"
payload = """
{"revision":1,"kind":"music","framesPerRow":2,"order":["p"],"patterns":{"p":{"rows":[[{"note":72,"sound":"tone","volume":0.5},null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null]]}},"loop":true}
"""

[[asset]]
name = "tone"
kind = "sound"
path = "tone.m01s"
payload = """
{"revision":1,"kind":"sound","waveform":"pulse","note":69,"durationFrames":4,"volume":0.5,"pan":0,"duty":0.5,"envelope":{"attackFrames":0,"decayFrames":0,"sustainLevel":1,"releaseFrames":1},"pitch":{"slideSemitonesPerFrame":0,"vibratoDepthSemitones":0,"vibratoPeriodFrames":0}}
"""
