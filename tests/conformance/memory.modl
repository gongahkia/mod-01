// Public MODL memory conformance; current machine addresses are decimal.
state frames: Int = 0
const CART_INFO: Int = 329216
const CART_ROM: Int = 1048576

on start:
  assert visual_id("absent") == -1, "unknown visual ID"
  assert mem_read(0) == 0, "RAM reset"
  mem_write16(1, 4660)
  assert mem_read(1) == 52, "little endian low byte"
  assert mem_read(2) == 18, "little endian high byte"
  assert mem_read16(1) == 4660, "unaligned word"
  mem_write(3, 7)
  mem_copy(2, 1, 3)
  assert mem_read(2) == 52, "overlap first"
  assert mem_read(3) == 18, "overlap middle"
  assert mem_read(4) == 7, "overlap last"
  mem_fill(1, 0, 4)
  assert mem_read16(1) == 0, "fill"
  assert mem_read(2097152) == 23, "fixed palette red"
  assert mem_read16(CART_INFO) == 2, "hardware revision"
  assert mem_read16(CART_INFO + 2) == 2, "cartridge format revision"
  assert mem_read16(CART_INFO + 8) == 0, "cartridge capacity low word"
  assert mem_read16(CART_INFO + 10) == 16, "cartridge capacity high word"
  assert mem_read16(CART_INFO + 12) == 0, "ROM base low word"
  assert mem_read16(CART_INFO + 14) == 16, "ROM base high word"
  assert mem_read(CART_INFO + 16) == 3, "present and canonical flags"
  assert mem_read(CART_ROM) == 77, "ROM magic M"
  assert mem_read(CART_ROM + 1) == 79, "ROM magic O"
  pixel(3, 0, 7)
  assert mem_read(102403) == 7, "boot draw alias"
  mem_write(102404, 23)

on update:
  frames += 1
  mem_write(100, frames % 256)
  assert mem_read(65539) == 7, "boot framebuffer persists"

on draw:
  pal(3, 11)
  assert mem_read(327731) == 11, "palette register alias"
  mem_write(327731, 7)
  pixel(5, 0, 3)
  assert mem_read(102405) == 7, "low palette affects drawing"
  pixel(0, 0, 7)
  assert mem_read(102400) == 7, "draw alias"
  mem_write(102401, 23)

on raster(line: Int):
  if line == 0:
    assert mem_read(102401) == 23, "raster reads current back"
    pal(23, 11)
    assert mem_read(348191) == 11, "raster callback table alias"
    mem_write(348168, 0)
